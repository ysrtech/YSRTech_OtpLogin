<?php
/**
 * YSRTech OtpLogin - registration popup (passwordless, email code only).
 *
 * @category  YSRTech
 * @package   YSRTech_OtpLogin
 * @var YSRTech_OtpLogin_Block_Form_Register $this
 */
?>
<?php if (!$this->customerIsAlreadyLoggedIn() && $this->isRegistrationAllowed()): ?>
<div id="ysrtech-otp-register" class="ysrtech-otp-modal" style="display:none;">
    <div class="ysrtech-otp-dialog">
        <button type="button" class="ysrtech-otp-close" data-otp-close="1" aria-label="<?php echo $this->__('Close') ?>">&times;</button>
        <h2 class="ysrtech-otp-title"><?php echo $this->__('Create an Account') ?></h2>
        <p class="ysrtech-otp-hint"><?php echo $this->__('Enter your details and we will email you a code to confirm your account. No password needed.') ?></p>

        <div class="ysrtech-otp-messages"></div>

        <form id="ysrtech-otp-register-form" class="ysrtech-otp-form ysrtech-otp-sendform">
            <div class="ysrtech-otp-field">
                <label for="ysrtech-reg-firstname"><?php echo $this->__('First Name') ?></label>
                <input type="text" id="ysrtech-reg-firstname" name="firstname" required
                       placeholder="<?php echo $this->__('First Name') ?>" class="input-text"/>
            </div>
            <div class="ysrtech-otp-field">
                <label for="ysrtech-reg-lastname"><?php echo $this->__('Last Name') ?></label>
                <input type="text" id="ysrtech-reg-lastname" name="lastname" required
                       placeholder="<?php echo $this->__('Last Name') ?>" class="input-text"/>
            </div>
            <div class="ysrtech-otp-field">
                <label for="ysrtech-reg-email"><?php echo $this->__('Email address') ?></label>
                <input type="email" id="ysrtech-reg-email" name="email" required
                       placeholder="<?php echo $this->__('Email address') ?>" autocomplete="email" class="input-text"/>
            </div>
            <div class="ysrtech-otp-actions">
                <button type="submit" class="button ysrtech-otp-send"
                        data-loading="<?php echo $this->__('Sending…') ?>"
                        data-url="<?php echo $this->getSendOtpUrl() ?>">
                    <span><?php echo $this->__('Create an Account') ?></span>
                </button>
            </div>
        </form>

        <?php if (Mage::helper('ysrtech_otplogin')->isGoogleEnabled()): ?>
            <div class="ysrtech-otp-or"><span><?php echo $this->__('or') ?></span></div>
            <a class="ysrtech-otp-google" href="<?php echo $this->getUrl('otplogin/google/connect', array('_secure' => true)) ?>">
                <span class="ysrtech-otp-google-icon" aria-hidden="true"></span>
                <span><?php echo $this->__('Sign up with Google') ?></span>
            </a>
        <?php endif; ?>

        <div class="ysrtech-otp-foot">
            <?php echo $this->__('Already have an account?') ?>
            <a href="#" data-otp-open="login"><?php echo $this->__('Sign in') ?></a>
        </div>
    </div>
</div>
<?php endif; ?>
