<?php
/**
 * YSRTech OtpLogin - sign-in popup (passwordless, email code only).
 *
 * @category  YSRTech
 * @package   YSRTech_OtpLogin
 * @var YSRTech_OtpLogin_Block_Form_Login $this
 */
?>
<?php if (!$this->customerIsAlreadyLoggedIn()): ?>
<div id="ysrtech-otp-login" class="ysrtech-otp-modal" style="display:none;">
    <div class="ysrtech-otp-dialog">
        <button type="button" class="ysrtech-otp-close" data-otp-close="1" aria-label="<?php echo $this->__('Close') ?>">&times;</button>
        <h2 class="ysrtech-otp-title"><?php echo $this->__('Sign In') ?></h2>
        <p class="ysrtech-otp-hint"><?php echo $this->__('Enter your email address and we will send you a code to sign in.') ?></p>

        <div class="ysrtech-otp-messages"></div>

        <form id="ysrtech-otp-email-form" class="ysrtech-otp-form ysrtech-otp-sendform">
            <div class="ysrtech-otp-field">
                <label for="ysrtech-otp-email"><?php echo $this->__('Email address') ?></label>
                <input type="email" id="ysrtech-otp-email" name="email" required
                       placeholder="<?php echo $this->__('Email address') ?>"
                       autocomplete="email" class="input-text"/>
            </div>
            <div class="ysrtech-otp-actions">
                <button type="submit" class="button ysrtech-otp-send"
                        data-loading="<?php echo $this->__('Sending…') ?>"
                        data-url="<?php echo $this->getSendOtpUrl() ?>">
                    <span><?php echo $this->__('Email me a sign-in code') ?></span>
                </button>
            </div>
        </form>

        <?php if (Mage::helper('ysrtech_otplogin')->isGoogleEnabled()): ?>
            <div class="ysrtech-otp-or"><span><?php echo $this->__('or') ?></span></div>
            <a class="ysrtech-otp-google" href="<?php echo $this->getUrl('otplogin/google/connect', array('_secure' => true)) ?>">
                <span class="ysrtech-otp-google-icon" aria-hidden="true"></span>
                <span><?php echo $this->__('Sign in with Google') ?></span>
            </a>
        <?php endif; ?>

        <?php if ($this->isRegistrationAllowed()): ?>
            <div class="ysrtech-otp-foot">
                <?php echo $this->__('New customer?') ?>
                <a href="#" data-otp-open="register"><?php echo $this->__('Create an account') ?></a>
            </div>
        <?php endif; ?>
    </div>
</div>
<?php endif; ?>
